# Claude API
ANTHROPIC_API_KEY=

# Gmail OAuth client (Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Application type: "Desktop app".
# Gmail scopes are not allowed on Google's device-code flow, so this must be
# a Desktop app client, not "TVs and Limited Input devices".)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by `npm run auth:gmail` — do not edit by hand
GOOGLE_REFRESH_TOKEN=

# Outlook OAuth app (Azure Portal -> App registrations -> New registration
# -> Supported account types: "Personal Microsoft accounts only" is fine for
# a single personal Outlook.com mailbox; enable "Allow public client flows" -> Yes)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=consumers
# Produced once by `npm run auth:outlook` — do not edit by hand
MICROSOFT_REFRESH_TOKEN=

# Resend (resend.com) — used only to send the digest email, not to read mail
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=

# How far back to look for new mail on each run. Must match how often you
# actually schedule `npm run digest` (see .github/workflows/digest.yml).
LOOKBACK_HOURS=6

# Where Phase 2 stores Summaries and Detected Events (ADR-0005). Local file, git-ignored.
DATABASE_PATH=data/mail-digest.db

# Timezone that relative dates in emails ("next Thursday") are resolved against.
# Defaults to the machine's timezone.
TIMEZONE=Asia/Taipei

# The addresses of the connected mailboxes, used to pick the default Target Calendar.
# GMAIL_ACCOUNT_EMAIL is looked up automatically when unset. OUTLOOK_ACCOUNT_EMAIL
# cannot be (reading it needs a scope the Mail.Read-only token lacks), so set it.
GMAIL_ACCOUNT_EMAIL=
OUTLOOK_ACCOUNT_EMAIL=

# Set to "false" where the database does not survive the run (the scheduled GitHub
# Actions job sets this). Leave unset on the machine that keeps the database.
DETECT_EVENTS=true
